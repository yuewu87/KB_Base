# ---- Python ----
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
.conda/

# ---- 测试与类型检查缓存（新位置见 pyproject.toml 的 data/cache/）----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---- 环境变量与密钥 ----
# .env 是**配置**不是运行数据，留在根上；但绝不能入库
.env
.env.*
!.env.example
*.key
*.pem

# ---- 本机依赖锁定（含平台相关包，不跨平台）----
requirements.lock.txt

# ---- 运行数据（**一整棵都不入库**）----
#
# data/ 里是服务运行时产生的东西：logs/ 运行日志、runtime/service.json、
# chats/ 会话历史、cache/ 工具缓存。
#
# **为什么整棵排除**：本仓库是 public 的，而会话历史里有个人对话内容——
# 进去就等于公开发布。这条线要一眼看得见，所以不逐个列，整棵排除。
#
# 代价：换机器时 data/ 不跟着 git 走，要手动拷（日志和会话本身也未必需要）。
data/
#
# 确认：会话历史落在 data/chats/，已被上面这条整棵排除覆盖，不另加 chats/ 条目
# （裸写 chats/ 会连代码里任何叫 chats 的目录一起排除，范围超出本意）。
# 这里是点名，不是新增规则——改这两行的人请先确认 data/ 还在。

*.db
*.sqlite
*.sqlite3
*.faiss
chroma/
*.index

# ---- 编辑器与系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Notebook ----
.ipynb_checkpoints/
