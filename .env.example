# 复制本文件为 .env 并填写。.env 不入库。
# KB_LLM_BASE_URL / KB_LLM_MODEL 为必填项，已给出 DeepSeek 的当前值。
KB_LLM_API_KEY=
KB_LLM_BASE_URL=https://api.deepseek.com
KB_LLM_MODEL=deepseek-flash
# 知识库目录。**没有默认值**——留空就是「还没有知识库」，服务会拒绝投递并
# 引导你去网页上初始化。正常不用手填：点「初始化知识库」时它会自己写进来。
KB_VAULT_PATH=
# 留空则自动寻找未占用端口
KB_PORT=
# 日志级别：INFO（默认）/ DEBUG（排查问题时用）
KB_LOG_LEVEL=INFO
# 距上次巡检超过这么多天就自动跑一次
KB_SWEEP_INTERVAL=6
# 服务侧日志（流程 + 运行）保留多少天，更早的启动时清掉
KB_LOG_KEEP_DAYS=90
# 界面皮肤：dark-pink（默认，炭黑甜酷粉）/ archive（现有蓝）/ aurora / garnet / neon / mono
KB_SKIN=dark-pink
